---
import BairroLinks from '../../components/BairroLinks.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import Hero from '../../components/Hero.astro';
import Section from '../../components/Section.astro';
import Gallery from '../../components/Gallery.astro';
import BeforeAfter from '../../components/BeforeAfter.astro';
import HowWeWork from '../../components/HowWeWork.astro';
import ContactForm from '../../components/ContactForm.astro';
import CtaBand from '../../components/CtaBand.astro';
import { getHubData, serviceLocs, pageSlug, validateContent } from '../../lib/pages';
import { siteConfig, getService, absoluteUrl } from '../../config/siteConfig';
import { beforeAfterFor, coverFor, galleryFor } from '../../config/photos';
import { breadcrumbLd, collectionLd, localBusinessLd } from '../../lib/schema';

export function getStaticPaths() {
  validateContent();
  return siteConfig.services.map((s) => ({ params: { servico: s.slug } }));
}

const { servico } = Astro.params;
const service = getService(servico as string);
const index = siteConfig.services.findIndex((s) => s.slug === service.slug);
const { data: hub, missing } = getHubData(service.slug);
const path = `/servicos/${service.slug}/`;
const crumbs = [
  { name: 'Início', path: '/' },
  { name: 'Serviços', path: '/servicos/' },
  { name: service.label, path },
];
const locs = serviceLocs(service.slug);
const gallery = service.hasPhotos ? galleryFor(service.slug).slice(0, 6) : [];
const beforeAfter = service.hasPhotos ? beforeAfterFor(service.slug) : [];
const message = `Olá! Vim pelo site da Signature Pisos e gostaria de um orçamento de ${service.label}.`;
---

<BaseLayout
  title={hub.title}
  description={hub.description}
  path={path}
  noindex={missing}
  ld={[localBusinessLd(), breadcrumbLd(crumbs), collectionLd(hub.h1, absoluteUrl(path), hub.description)]}
>
  <Breadcrumb items={crumbs} />
  <Hero h1={hub.h1} subtitle={hub.intro} photo={coverFor(service.slug)} tonal={{ service, index }} secondaryHref="#sec-cidades" secondaryLabel="Ver cidades atendidas" whatsappMessage={message} />

  <Section tone="sand" labelledby="sec-cidades">
    <h2 id="sec-cidades" class="text-2xl md:text-3xl">{service.label} por cidade</h2>
    <p class="mt-3 max-w-prose text-base text-ink-soft">Escolha a cidade para ver bairros atendidos e perguntas frequentes.</p>
    <ul class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {
        locs.map((l) => (
          <li>
            <a
              href={`/${pageSlug(l)}/`}
              class="flex min-h-14 items-center justify-between rounded-sm border-2 border-line bg-paper px-4 py-3 text-lg font-semibold text-graphite no-underline hover:border-graphite"
            >
              <span>{service.label} em {l.cidadeLabel}</span>
              <span aria-hidden="true" class="text-accent-strong">&rarr;</span>
            </a>
          </li>
        ))
      }
    </ul>
    <h3 class="mb-4 mt-12 text-xl">{service.label} por bairro de São Paulo</h3>
    <BairroLinks servico={service.slug} label={`${service.label} por bairro`} />
  </Section>

  <Section labelledby={service.hasPhotos ? 'sec-galeria' : 'sec-etapas'}>
    <div class="grid gap-12">
      {
        service.hasPhotos ? (
          <>
            <Gallery photos={gallery} headingId="sec-galeria" />
            <BeforeAfter photos={beforeAfter} headingId="sec-antes-depois" />
          </>
        ) : (
          <HowWeWork service={service} headingId="sec-etapas" />
        )
      }
    </div>
  </Section>

  <CtaBand message={message} />

  <Section tone="paper" compact id="contato" labelledby="sec-contato" class="border-t border-line">
    <ContactForm compact headingId="sec-contato" defaultService={service.slug} />
  </Section>
</BaseLayout>
