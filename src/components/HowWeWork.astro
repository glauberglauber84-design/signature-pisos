---
import type { Service } from '../config/siteConfig';

interface Props {
  service: Service;
  headingId: string;
}
const { service, headingId } = Astro.props;
---

<div>
  <h2 id={headingId} class="text-2xl md:text-3xl">Como trabalhamos</h2>
  <p class="mt-3 max-w-prose text-base text-ink-soft">Etapas gerais do serviço de {service.label.toLowerCase()}.</p>
  <ol class="mt-6 grid gap-4 sm:grid-cols-2">
    {
      service.steps.map((step, i) => (
        <li class="flex gap-4 rounded-sm border-2 border-line bg-paper p-4">
          <span class="font-display text-2xl text-accent-strong" aria-hidden="true">{i + 1}</span>
          <span class="text-base text-graphite">{step}</span>
        </li>
      ))
    }
  </ol>
</div>
