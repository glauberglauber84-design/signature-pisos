---
import Picture from './Picture.astro';
import type { Photo } from '../config/photos';

interface Props {
  photos: Photo[];
  headingId: string;
}
const { photos, headingId } = Astro.props;
---

{
  photos.length > 0 && (
    <div>
      <h3 id={headingId} class="text-xl md:text-2xl">Antes e depois</h3>
      <ul class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2">
        {photos.map((p, i) => (
          <li>
            <figure class="overflow-hidden rounded-sm border-2 border-line bg-paper">
              <Picture photo={p} sizes="(min-width: 640px) 45vw, 90vw" class="h-auto w-full" />
              <figcaption class="px-4 py-2 text-base font-semibold text-graphite">Antes e depois, trabalho {i + 1}</figcaption>
            </figure>
          </li>
        ))}
      </ul>
    </div>
  )
}
