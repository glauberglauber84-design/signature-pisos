---
import { siteConfig } from '../config/siteConfig';

interface Props {
  text: string;
  headingId: string;
  heading?: string;
}
const { text, headingId, heading = `Sobre a ${siteConfig.name}` } = Astro.props;
const paragraphs = text.split(/\n{2,}/).map((p) => p.trim()).filter(Boolean);
const r = siteConfig.responsavel;
---

<div class="grid gap-8 md:grid-cols-3 md:gap-16">
  <div class="md:col-span-2">
    <h2 id={headingId} class="text-2xl md:text-3xl">{heading}</h2>
    <div class="prose-block mt-6 max-w-prose text-base text-graphite">
      {paragraphs.map((p) => <p>{p}</p>)}
    </div>
  </div>
  <aside class="self-start rounded-sm border-2 border-line bg-paper p-6" aria-label="Responsável técnico">
    <p class="text-sm font-semibold uppercase tracking-widest text-accent-strong">{r.cargo}</p>
    <p class="mt-2 font-display text-xl text-graphite">{r.nome}</p>
    <p class="mt-2 text-base text-ink-soft">{r.bio}</p>
  </aside>
</div>
