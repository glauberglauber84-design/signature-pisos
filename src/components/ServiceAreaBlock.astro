---
import CityLinks from './CityLinks.astro';
import WhatsAppButton from './WhatsAppButton.astro';
import { siteConfig } from '../config/siteConfig';

interface Props {
  headingId: string;
  cityLabel: string;
  bairros: string[];
  servico?: string;
  cidade?: string;
  message?: string;
}
const { headingId, cityLabel, bairros, servico, cidade, message } = Astro.props;
const map = siteConfig.mapEmbed;
---

<div class="grid gap-8 md:grid-cols-2 md:gap-16">
  <div>
    <h2 id={headingId} class="text-2xl md:text-3xl">Como nos encontrar</h2>
    <p class="mt-4 text-base text-graphite">
      Atendemos {cityLabel} e região. Nossa área de atendimento: {siteConfig.areaAtendimento.resumo}.
    </p>
    <h3 class="mt-6 text-lg">Bairros atendidos em {cityLabel}</h3>
    <ul class="mt-2 flex flex-wrap gap-2">
      {bairros.map((b) => <li class="rounded-sm bg-sand px-3 py-1 text-base text-graphite">{b}</li>)}
    </ul>
    <WhatsAppButton class="mt-6" message={message} />
  </div>
  <div>
    {
      map.enabled && map.src ? (
        <iframe
          src={map.src}
          title="Mapa da região de atendimento"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          class="aspect-[4/3] w-full rounded-sm border-0"
        />
      ) : null
    }
    {
      servico && cidade && (
        <div class={map.enabled && map.src ? 'mt-6' : ''}>
          <h3 class="text-lg">Este serviço em cidades vizinhas</h3>
          <div class="mt-3">
            <CityLinks servico={servico} exclude={cidade} limit={3} />
          </div>
        </div>
      )
    }
  </div>
</div>
