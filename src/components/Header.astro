---
import Container from './Container.astro';
import Logo from './Logo.astro';
import WhatsAppButton from './WhatsAppButton.astro';
import { siteConfig } from '../config/siteConfig';

interface Props {
  current?: string;
}
const { current = '' } = Astro.props;
const nav = [
  { label: 'Serviços', href: '/servicos/' },
  { label: 'Atendimento', href: '/atendimento/' },
  { label: 'Sobre', href: '/sobre/' },
  { label: 'Contato', href: '/contato/' },
];
---

<header class="relative z-30 border-b border-line bg-paper">
  <Container class="flex min-h-16 items-center justify-between gap-4 py-2">
    <a href="/" class="inline-flex min-h-11 items-center" aria-label={`${siteConfig.name}: página inicial`}>
      <Logo width={150} eager class="h-auto w-[150px] mix-blend-multiply" />
    </a>

    <nav aria-label="Principal" class="hidden items-center gap-6 md:flex">
      <ul class="flex items-center gap-2">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={current === item.href ? 'page' : undefined}
                class="inline-flex min-h-11 items-center px-3 text-base font-medium text-graphite no-underline hover:text-accent-strong hover:underline aria-[current=page]:text-accent-strong aria-[current=page]:underline"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <WhatsAppButton text="Orçamento" />
    </nav>

    <button
      type="button"
      id="menu-toggle"
      class="inline-flex min-h-11 min-w-11 items-center justify-center rounded-sm border-2 border-graphite px-3 text-graphite md:hidden"
      aria-expanded="false"
      aria-controls="menu-mobile"
      aria-label="Abrir menu"
    >
      <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false">
        <path id="menu-icon-open" d="M4 7h16M4 12h16M4 17h16"></path>
        <path id="menu-icon-close" class="hidden" d="M6 6l12 12M18 6L6 18"></path>
      </svg>
    </button>
  </Container>

  <div id="menu-mobile" class="hidden border-t border-line bg-paper md:hidden">
    <Container class="py-4">
      <nav aria-label="Principal (mobile)">
        <ul class="flex flex-col">
          {
            nav.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={current === item.href ? 'page' : undefined}
                  class="flex min-h-12 items-center border-b border-line text-lg font-medium text-graphite no-underline aria-[current=page]:text-accent-strong"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <WhatsAppButton class="mt-4 w-full" />
    </Container>
  </div>
</header>

<script>
  const btn = document.getElementById('menu-toggle') as HTMLButtonElement | null;
  const menu = document.getElementById('menu-mobile');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');
  if (btn && menu && iconOpen && iconClose) {
    const set = (open: boolean): void => {
      btn.setAttribute('aria-expanded', String(open));
      btn.setAttribute('aria-label', open ? 'Fechar menu' : 'Abrir menu');
      menu.classList.toggle('hidden', !open);
      iconOpen.classList.toggle('hidden', open);
      iconClose.classList.toggle('hidden', !open);
    };
    btn.addEventListener('click', () => set(btn.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') {
        set(false);
        btn.focus();
      }
    });
  }
</script>
