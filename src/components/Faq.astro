---
import type { FaqItem } from '../lib/pages';

interface Props {
  items: FaqItem[];
  headingId: string;
}
const { items, headingId } = Astro.props;
---

{
  items.length > 0 && (
    <div>
      <h2 id={headingId} class="text-2xl md:text-3xl">Perguntas frequentes</h2>
      <div class="mt-6 divide-y divide-line border-y border-line">
        {items.map((f) => (
          <details class="group py-1">
            <summary class="flex min-h-12 cursor-pointer list-none items-center justify-between gap-4 py-2 text-lg font-semibold text-graphite marker:hidden [&::-webkit-details-marker]:hidden">
              <span>{f.pergunta}</span>
              <svg class="h-5 w-5 shrink-0 text-accent-strong transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" focusable="false">
                <path d="M6 9l6 6 6-6" />
              </svg>
            </summary>
            <p class="max-w-prose pb-4 text-base text-ink-soft">{f.resposta}</p>
          </details>
        ))}
      </div>
    </div>
  )
}
