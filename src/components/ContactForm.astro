---
import WhatsAppButton from './WhatsAppButton.astro';
import { siteConfig, whatsappLink } from '../config/siteConfig';

interface Props {
  headingId: string;
  defaultService?: string;
  defaultCity?: string;
  heading?: string;
}
const { headingId, defaultService, defaultCity, heading = 'Peça seu orçamento' } = Astro.props;
const f = siteConfig.form;
const keyIsPlaceholder = f.accessKey === 'SUBSTITUIR_PELA_CHAVE' || !f.accessKey;
const configured =
  f.provider === 'web3forms' ? !keyIsPlaceholder : f.provider === 'formspree' ? !f.endpoint.includes('<') : false;

const field = 'block w-full min-h-12 rounded-sm border-2 border-graphite bg-white px-3 py-2 text-base text-graphite aria-[invalid=true]:border-danger';
const label = 'mb-1 block text-base font-semibold text-graphite';
const err = 'mt-1 hidden text-base font-medium text-danger';
---

<div>
  <h2 id={headingId} class="text-2xl md:text-3xl">{heading}</h2>
  <p class="mt-3 max-w-prose text-base text-ink-soft">
    Conte o que precisa. Respondemos pelo WhatsApp ou pelo retorno ao seu pedido. Não pedimos telefone neste formulário.
  </p>

  <form
    id="contact-form"
    data-wa-cta
    method={configured ? 'post' : undefined}
    action={configured ? f.endpoint : undefined}
    novalidate
    class="mt-6 grid gap-4 md:grid-cols-2"
    data-configured={String(configured)}
    data-provider={f.provider}
    data-endpoint={f.endpoint}
    data-key={configured && f.provider === 'web3forms' ? f.accessKey : ''}
  >
    <div>
      <label for="cf-nome" class={label}>Nome</label>
      <input id="cf-nome" name="nome" type="text" autocomplete="name" required aria-describedby="cf-nome-err" class={field} />
      <p id="cf-nome-err" class={err} data-err-for="cf-nome">Informe seu nome.</p>
    </div>

    <div>
      <label for="cf-cidade" class={label}>Cidade / bairro</label>
      <select id="cf-cidade" name="cidade" required aria-describedby="cf-cidade-err" class={field}>
        <option value="">Selecione</option>
        {siteConfig.cities.map((c) => <option value={c.label} selected={c.slug === defaultCity}>{c.label}</option>)}
        <option value="Outra">Outra</option>
      </select>
      <p id="cf-cidade-err" class={err} data-err-for="cf-cidade">Escolha a cidade.</p>
    </div>

    <div class="md:col-span-2">
      <label for="cf-servico" class={label}>Serviço</label>
      <select id="cf-servico" name="servico" required aria-describedby="cf-servico-err" class={field}>
        <option value="">Selecione</option>
        {siteConfig.services.map((s) => <option value={s.label} selected={s.slug === defaultService}>{s.label}</option>)}
      </select>
      <p id="cf-servico-err" class={err} data-err-for="cf-servico">Escolha o serviço.</p>
    </div>

    <div class="md:col-span-2">
      <label for="cf-mensagem" class={label}>Mensagem <span class="font-normal text-ink-soft">(opcional)</span></label>
      <textarea id="cf-mensagem" name="mensagem" rows="4" class={field}></textarea>
    </div>

    <div class="md:col-span-2">
      <div class="flex items-start gap-3">
        <input id="cf-lgpd" name="lgpd" type="checkbox" required aria-describedby="cf-lgpd-err" class="mt-1 h-6 w-6 shrink-0 accent-accent-strong" />
        <label for="cf-lgpd" class="text-base text-graphite">
          Concordo com o uso dos dados informados para retorno do orçamento, conforme a
          <a href="/politica-de-privacidade/" class="font-semibold text-accent-strong underline">política de privacidade</a>.
        </label>
      </div>
      <p id="cf-lgpd-err" class={err} data-err-for="cf-lgpd">É necessário concordar para enviar.</p>
    </div>

    <div class="hidden" aria-hidden="true">
      <label for="cf-site">Não preencha este campo</label>
      <input id="cf-site" name="botcheck" type="text" tabindex="-1" autocomplete="off" />
    </div>
    {f.provider === 'web3forms' && configured && <input type="hidden" name="subject" value="Novo pedido de orçamento pelo site" />}

    <div class="flex flex-col gap-3 sm:flex-row md:col-span-2">
      <button
        type="submit"
        class="inline-flex min-h-12 items-center justify-center rounded-sm border-2 border-graphite bg-graphite px-6 py-2 text-base font-semibold text-paper hover:bg-graphite-soft disabled:opacity-60"
      >
        Enviar pedido
      </button>
      <WhatsAppButton variant="secondary" text="Falar direto no WhatsApp" />
      <a id="cf-wa" href={whatsappLink()} class="hidden" tabindex="-1" aria-hidden="true">.</a>
    </div>

    <p id="cf-status" role="status" aria-live="polite" class="text-base font-semibold text-ok md:col-span-2"></p>
  </form>
  <noscript>
    <p class="mt-4 text-base text-graphite">Sem JavaScript, use o botão "Falar direto no WhatsApp" acima.</p>
  </noscript>
</div>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const status = document.getElementById('cf-status');
  const waAnchor = document.getElementById('cf-wa') as HTMLAnchorElement | null;

  if (form && status && waAnchor) {
    const submitBtn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const waBase = waAnchor.href.split('?')[0];

    const setStatus = (msg: string, danger = false): void => {
      status.textContent = msg;
      status.classList.toggle('text-danger', danger);
      status.classList.toggle('text-ok', !danger);
    };

    const validate = (): boolean => {
      let first: HTMLElement | null = null;
      form.querySelectorAll<HTMLElement>('[data-err-for]').forEach((p) => {
        const input = document.getElementById(p.dataset.errFor ?? '') as HTMLInputElement | HTMLSelectElement | null;
        if (!input) return;
        const bad = !input.checkValidity();
        p.classList.toggle('hidden', !bad);
        input.setAttribute('aria-invalid', String(bad));
        if (bad && !first) first = input;
      });
      (first as HTMLElement | null)?.focus();
      return first === null;
    };

    const openWhatsApp = (): void => {
      const d = new FormData(form);
      const nome = String(d.get('nome') ?? '').trim();
      const cidade = String(d.get('cidade') ?? '').trim();
      const servico = String(d.get('servico') ?? '').trim();
      const msg = String(d.get('mensagem') ?? '').trim();
      const text = `Olá! Meu nome é ${nome}, moro em ${cidade}, preciso de ${servico}${msg ? `: ${msg}` : '.'}`;
      window.open(`${waBase}?text=${encodeURIComponent(text)}`, '_blank', 'noopener');
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!validate()) return;
      const d = new FormData(form);
      if (d.get('botcheck')) return;
      if (submitBtn) submitBtn.disabled = true;

      const configured = form.dataset.configured === 'true';
      let sent = false;
      if (configured) {
        try {
          if (form.dataset.provider === 'web3forms') d.append('access_key', form.dataset.key ?? '');
          const res = await fetch(form.dataset.endpoint ?? '', { method: 'POST', body: d, headers: { Accept: 'application/json' } });
          const json = (await res.json().catch(() => ({}))) as { success?: boolean; ok?: boolean };
          sent = res.ok && (json.success === true || json.ok === true || form.dataset.provider === 'formspree');
        } catch {
          sent = false;
        }
      }
      if (sent) {
        setStatus('Pedido enviado. Entraremos em contato em breve.');
        form.reset();
      } else {
        openWhatsApp();
        setStatus(
          configured
            ? 'Não foi possível enviar agora. Abrimos o WhatsApp com a sua mensagem pronta para você enviar.'
            : 'Abrimos o WhatsApp com a sua mensagem pronta. Falta só tocar em enviar por lá.',
          configured,
        );
      }
      if (submitBtn) submitBtn.disabled = false;
    });
  }
</script>
