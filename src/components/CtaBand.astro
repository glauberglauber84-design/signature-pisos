---
import Container from './Container.astro';
import WhatsAppButton from './WhatsAppButton.astro';

interface Props {
  heading?: string;
  text?: string;
  message?: string;
}
const { heading = 'Vamos conversar sobre a sua obra?', text = 'Mande fotos ou medidas pelo WhatsApp e receba orientação para o seu caso.', message } = Astro.props;
---

<section class="on-dark bg-graphite py-12 text-paper md:py-16" aria-label="Chamada para orçamento">
  <Container class="flex flex-col items-start justify-between gap-6 md:flex-row md:items-center">
    <div>
      <p class="font-display text-2xl text-paper md:text-3xl">{heading}</p>
      <p class="mt-2 max-w-xl text-base text-paper">{text}</p>
    </div>
    <WhatsAppButton message={message} />
  </Container>
</section>
